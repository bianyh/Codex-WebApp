{
  "name": "codex-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:daemon\" \"npm:dev:web\"",
    "dev:daemon": "tsx apps/daemon/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run build:web && npm run build:daemon",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:daemon": "tsc -p apps/daemon/tsconfig.json",
    "start": "node apps/daemon/dist/index.js",
    "codex:schema": "node scripts/generate-codex-schema.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.2",
    "argon2": "^0.41.1",
    "fastify": "^5.3.3",
    "katex": "^0.18.5",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "ws": "^8.18.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
